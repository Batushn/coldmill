{
  "name": "coldmill",
  "version": "0.2.0",
  "description": "Offline batch file converter for audio, video, images, documents and 3D models. Drag, drop, done.",
  "license": "GPL-3.0-or-later",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "check:locales": "node scripts/check-locales.mjs",
    "preview": "vite --config vite.preview.config.ts",
    "capture": "node scripts/capture-screens.mjs",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "tauri build",
    "icons": "node scripts/generate-logo.mjs && tauri icon assets/logo.png"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "@tauri-apps/plugin-opener": "^2.2.5",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.2.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "puppeteer-core": "^25.6.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
